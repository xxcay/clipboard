<Application x:Class="SharedClipboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- Palette: white + orange. -->
    <SolidColorBrush x:Key="Bg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#F0E8E2" />
    <SolidColorBrush x:Key="Fg" Color="#1C1917" />
    <SolidColorBrush x:Key="Muted" Color="#8C837D" />
    <SolidColorBrush x:Key="Line" Color="#F2ECE7" />
    <SolidColorBrush x:Key="Hover" Color="#FFF5EE" />
    <SolidColorBrush x:Key="Selected" Color="#FFEBDD" />
    <SolidColorBrush x:Key="Tile" Color="#FFF1E7" />
    <SolidColorBrush x:Key="ChipBg" Color="#F7F3F0" />
    <SolidColorBrush x:Key="ChipHover" Color="#FFEDE1" />
    <SolidColorBrush x:Key="Accent" Color="#FF6A1F" />
    <SolidColorBrush x:Key="AccentSoft" Color="#FFF1E7" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FFF0F0" />
    <SolidColorBrush x:Key="Ok" Color="#30A46C" />
    <SolidColorBrush x:Key="Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder" Color="#E8DFD8" />
    <SolidColorBrush x:Key="ToggleOff" Color="#E4DCD6" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#E6DDD6" />
    <SolidColorBrush x:Key="ToastBg" Color="#1C1917" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF9040" Offset="0" />
      <GradientStop Color="#FF5A1F" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

