<Window x:Class="SharedClipboard.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        xmlns:local="clr-namespace:SharedClipboard"
        Title="Общий буфер"
        Width="400" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowDrop="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Fg}"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnKeyDown"
        DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
  <Window.Resources>
    <local:BoolToVisibility x:Key="Vis" />
    <local:BoolToVisibility x:Key="NotVis" Invert="True" />

    <ContextMenu x:Key="ItemMenu" x:Shared="False">
      <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Click="OnCopy" />
      <MenuItem Header="{Binding PrimaryActionTip}" Click="OnOpen"
                Visibility="{Binding IsText, Converter={StaticResource NotVis}}" />
      <MenuItem Header="Показать в папке" Click="OnShowInFolder"
                Visibility="{Binding IsFile, Converter={StaticResource Vis}}" />
      <MenuItem Header="Сохранить как…" Click="OnSaveAs"
                Visibility="{Binding IsFile, Converter={StaticResource Vis}}" />
      <Separator />
      <MenuItem Header="Удалить из общего буфера" InputGestureText="Del" Click="OnDelete" />
    </ContextMenu>

    <Style x:Key="ItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="8,6" Margin="0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ItemTemplate" DataType="{x:Type local:ItemViewModel}">
      <Grid ToolTip="{Binding PrimaryActionTip}" ToolTipService.InitialShowDelay="1200">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="5" Background="{DynamicResource Hover}" ClipToBounds="True">
          <Grid>
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                       Foreground="{DynamicResource Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasThumbnail, Converter={StaticResource NotVis}}" />
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                   Visibility="{Binding HasThumbnail, Converter={StaticResource Vis}}" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="11.5" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Accent}" FontSize="11.5" Margin="6,0,0,0" />
          </StackPanel>
        </StackPanel>
        <!-- Row buttons float over the text end, so they take no room when hidden. -->
        <Border x:Name="Actions" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="{DynamicResource Bg}" CornerRadius="6" Padding="2" Visibility="Hidden">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Копировать" Click="OnCopy" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="{Binding PrimaryActionTip}" Click="OnOpen"
                    Visibility="{Binding IsText, Converter={StaticResource NotVis}}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Удалить" Click="OnDelete" />
          </StackPanel>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border Margin="12" CornerRadius="8" Background="{DynamicResource Bg}"
          BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Margin="14,10,8,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Общий буфер" FontSize="15" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                     Fill="{DynamicResource Muted}" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12"
                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE77F;"
                ToolTip="Отправить то, что сейчас в буфере обмена (Ctrl+V)" Click="OnSendClipboard" />
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                ToolTip="Настройки" Click="OnSettings" />
      </Grid>

      <!-- Items -->
      <ListBox x:Name="List" Grid.Row="1" ItemsSource="{Binding Items}"
               ItemTemplate="{StaticResource ItemTemplate}" ItemContainerStyle="{StaticResource ItemStyle}"
               SelectionMode="Extended" BorderThickness="0" FocusVisualStyle="{x:Null}" Background="Transparent" Padding="6,0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.ScrollUnit="Pixel"
               PreviewMouseLeftButtonDown="OnListMouseDown"
               PreviewMouseLeftButtonUp="OnListMouseUp"
               PreviewMouseMove="OnListMouseMove"
               MouseDoubleClick="OnListDoubleClick" />

      <TextBlock x:Name="EmptyText" Grid.Row="1" TextAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="30,0"
                 Text="Пока пусто.&#x0a;Перетащите сюда файлы или нажмите Ctrl+V, чтобы отправить их на другие устройства." />

      <!-- Footer -->
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="14,8">
        <TextBlock x:Name="FooterText" Foreground="{DynamicResource Muted}" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
      </Border>

      <!-- Shown while files are dragged over the window -->
      <Border x:Name="DropOverlay" Grid.RowSpan="3" CornerRadius="8" Visibility="Collapsed"
              IsHitTestVisible="False" Background="{DynamicResource Bg}">
        <Grid Margin="10">
          <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                     StrokeDashArray="4 3" Fill="{DynamicResource Selected}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="36"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
            <TextBlock Text="Отпустите, чтобы отправить" FontSize="15" Margin="0,10,0,0"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
