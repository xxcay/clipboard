config clipd 'main'
	option enabled '1'
	# Port the hub listens on (the GL.iNet web UI keeps 80/443).
	option listen ':8765'
	# Access token; generated by install.sh when empty.
	option token ''
	# Files and history live in RAM (/tmp) so the flash is not worn out.
	option data_dir '/tmp/clipd'
	option max_file_mb '20'
	# Total size of stored files; the oldest files are removed first.
	option quota_mb '80'
	# Files older than this are removed (Go duration: 24h, 90m, 0 = never).
	option file_ttl '24h'
	# Number of clipboard entries to keep.
	option history '50'
