#!/bin/sh /etc/rc.common
# Shared clipboard hub (clipd).

START=95
STOP=10
USE_PROCD=1
PROG=/usr/bin/clipd

start_service() {
	config_load clipd

	local enabled listen token data_dir max_file_mb quota_mb file_ttl history
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get listen main listen ':8765'
	config_get token main token ''
	config_get data_dir main data_dir '/tmp/clipd'
	config_get max_file_mb main max_file_mb '20'
	config_get quota_mb main quota_mb '80'
	config_get file_ttl main file_ttl '24h'
	config_get history main history '50'

	if [ -z "$token" ]; then
		token="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24)"
		uci -q set clipd.main.token="$token" && uci -q commit clipd
	fi

	procd_open_instance
	procd_set_param command "$PROG" \
		-listen "$listen" \
		-data "$data_dir" \
		-max-file-mb "$max_file_mb" \
		-quota-mb "$quota_mb" \
		-file-ttl "$file_ttl" \
		-history "$history"
	# Passed via the environment so the token does not show up in `ps`.
	procd_set_param env CLIPD_TOKEN="$token"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger clipd
}
